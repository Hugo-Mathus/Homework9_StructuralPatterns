@startuml

Class SongService<interface>{
    +searchByID(Integer songID): Song
    +searchByTitle(String title): List<Song>
    +searchByAlbum(String album): List<Song>
}

Class SongServiceProxy{
    -SongService realService
    -Map<Integer,Song> idCache
    -Map > titlecache
    -Map > albumCache

    +searchByID(Integer songID): Song
    +searchByTitle(String title): List<Song>
    +searchByAlbum(String album): List<Song>
}

Class RealSongService{
    -Map<Integer,Song> songs
    +searchById(Integer songID): Song
    +searchByTitle(String title): List<Song>
    +seatchByAlbum(String album): List<Song>
}

Class Song{
    -String title
    -String artist
    -String album
    -int duration

    +getTitle(): String
    +getArtist(): String
    +getAlbum(): String
    +getDuration(): int
}

Class ProxyDriver{
    +main(String[] args): void
}

SongServiceProxy *--/references SongService
SongServiceProxy ..> SongService
ProxyDriver -->/user SongService
SongService <|.. RealSongService
RealSongService --/retrieves> Song

@enduml